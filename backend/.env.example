NODE_ENV=development
PORT=8080
API_PREFIX=api/v1
# Use a separate sandbox database. PostgreSQL sessions must use UTC.
DATABASE_URL=postgresql://stayq:CHANGE_ME@127.0.0.1:5432/stayq_db?schema=public
POSTGRES_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=false
# Prefer Application Default Credentials. Never commit a service-account key.
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-configured-bucket
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Required, generated independently: base64 of 32 cryptographically random bytes.
DATA_ENCRYPTION_KEY=
# At least 32 random characters; separate from the encryption key.
OTP_HMAC_SECRET=
# Checkout and verification are separate Cashfree products and credentials.
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_PG_APP_ID=
CASHFREE_PG_SECRET_KEY=
CASHFREE_PG_BASE_URL=https://sandbox.cashfree.com/pg
PUBLIC_API_URL=https://your-api.example/api/v1
PAYMENT_RETURN_URL=https://your-app.example/payment-return?order_id={order_id}
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification
# Merchant-issued RSA public key, if required by your Verification Suite account.
CASHFREE_PUBLIC_KEY=
# Comma-separated exact HTTPS hosts. No wildcard or private network destinations.
KYC_PORTRAIT_HOSTS=
CALENDAR_ALLOWED_HOSTS=
# Set true for the durable database worker, or schedule the authenticated /webhooks/jobs/run endpoint.
JOBS_ENABLED=true
CLOUD_TASKS_SECRET=
# Optional legacy Cloud Tasks reminder configuration.
GOOGLE_CLOUD_PROJECT=
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=
# Payouts are unavailable by default. MANUAL records an already-completed external transfer.
PAYOUT_MODE=DISABLED
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Enable only after installing and configuring the Firebase Trigger Email extension.
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_COLLECTION=mail
# Optional AI features; no fabricated responses when an integration is unavailable.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SEED_CORRIDORS=false
